# Adapted from AGOT's Valyrian steel customizer. Uses design IDs rather than temporary artifacts.
widget = {
 name = "vt_astral_design_selection"
 size = { 440 250 }
 vbox = {
  layoutpolicy_horizontal = expanding layoutpolicy_vertical = expanding
  scrollarea = {
   layoutpolicy_horizontal = expanding layoutpolicy_vertical = expanding
   scrollbarpolicy_vertical = always_on
   scrollbarpolicy_horizontal = always_off
   scrollbar_vertical = { using = Scrollbar_Vertical }
   scrollwidget = {
    vbox = { spacing = 4
button_standard = {
 size = { 400 76 }
 down = "[GetScriptedGui('vt_astral_select_1').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
 onclick = "[GetScriptedGui('vt_astral_select_1').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
 icon = { position = { 6 6 } size = { 64 64 } texture = "gfx/interface/icons/artifact/vs_andal_arming_gold.dds" }
 text_single = { position = { 80 0 } size = { 310 76 } align = left|vcenter text = vt_astral_design_1 }
}
