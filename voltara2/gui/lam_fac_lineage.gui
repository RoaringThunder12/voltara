			}
			button_standard = {
				size = {
					170
					26
				}
				text = "lam_gn_book_main"
				onclick = "[GetScriptedGui('lam_sgui_gn_view_main').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
			}
			hbox = {
				spacing = 4
				datamodel = "[GetPlayer.MakeScope.Var('lam_fac_view').Char.MakeScope.GetList('lam_gn_books_old')]"
				item = {
					button_standard = {
						datacontext = "[Scope.Title]"
						size = {
							170
							26
						}
						text = "lam_gn_book_btn"
						onclick = "[GetScriptedGui('lam_sgui_gn_view_book').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'target', Title.MakeScope ).End )]"
					}
				}
			}
			expand = {}
		}
