# lam_lineage_ux: preserved across current generator rebuilds
window = {
	name = "lam_fac_lineage_window"
	parentanchor = center
	layer = middle
	size = {
		1600
		880
	}
	movable = yes
	visible = "[And( GetPlayer.IsValid, GetPlayer.MakeScope.Var('lam_fac_lineage_open').IsSet )]"
	datacontext = "[GetPlayer.MakeScope.Var('lam_gn_view').Title]"
	using = Window_Background
	using = Window_Decoration
	vbox = {
		using = Window_Margins
		ignoreinvisible = yes
		background = {
			using = Background_Area_Dark
		}
		header_pattern = {
			layoutpolicy_horizontal = expanding
			blockoverride
			"header_text"
			  {
				text = "lam_gn_title"
			}
			blockoverride
			"button_close"
			  {
				onclick = "[GetScriptedGui('lam_sgui_fac_lineage_toggle').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
			}
		}
		text_single = {
			text = "lam_gn_sub"
			fontsize = 16
			fontsize_min = 13
			max_width = 1500
			layoutpolicy_horizontal = expanding
			align = left|nobaseline
			margin = {
				14
				4
			}
			visible = no
		}
		hbox = {
			margin = {
				14
				2
			}
			spacing = 6
			layoutpolicy_horizontal = expanding
			visible = "[GetPlayer.MakeScope.Var('lam_fac_view').Char.MakeScope.Var('lam_gn_has_old').IsSet]"
