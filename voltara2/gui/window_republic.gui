	type republican_prestige_widget = widget
	{
		name = "republican_prestige"
		datacontext = "[Character.MakeScope.Var('republican_government_story').GetVariable('republican_prestige')]"
		layoutpolicy_horizontal = expanding
		button = {
			size = { 100% 100% }
			using = tooltip_ne
			tooltip = "republican_legacy_resource_tt"
		}

		background = {
			using = Background_Area_Dark_Border
			margin = { 2 2 }
		}
		size = { 112 50 }

		progressbar_standard = {
			name = "republican_prestige_progressbar"
			size = { 100% 100% }

			min = 0
			max = "[Character.MakeScope.Var('republican_government_story').ScriptValue('republican_legacy_cost')]"
			value = "[Scope.GetValue]"
		}
		vbox = {
			parentanchor = center

			hbox = {
				spacing = 6
				icon = {
					texture = "gfx/interface/icons/icon_republican_prestige.dds"
					size = { 30 30 }
				}

				flowcontainer = {
					margin_bottom = 7
					spacing = -6
					direction = vertical

					text_single = {
						name = "republican_prestige_value"
						text = "[Scope.GetValue|0]"

						max_width = 50
						default_format = "#high"
						using = Font_Size_Medium
					}
					text_single = {
						name = "balance"
						text = "[Character.MakeScope.ScriptValue('republican_prestige_gain')|1=]"
						max_width = 110

						default_format = "#low"
					}
				}
			}
		}
	}

	type republican_election_candidates = dynamicgridbox
	{
		maxhorizontalslots = 6
		maxverticalslots = 5
		datamodel_wrap = 5
		flipdirection = yes
		datamodel = "[Character.MakeScope.Var('republican_government_story').GetList('candidates')]"

		item = {
			widget = {

				datacontext = "[Scope.Char]"
				size = { 106 140 }
				vbox = {
					portrait_head_small = {
						size = { 115 100 }
						blockoverride "portrait_texture" {
							portrait_texture = "[Character.GetPortrait('environment_head', 'camera_head', 'idle', PdxGetWidgetScreenSize(PdxGuiWidget.Self))]"
							scale = 1.18
						}
						button = {
							visible = "[GetScriptedGui( 'republican_election_ongoing_sguitrigger' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
							enabled = "[GetScriptedGui( 'republican_support_candidate' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'candidate', Character.MakeScope ).End )]"
							tooltip = "republican_election_candidates_support_campaign_tt"
							clicksound = "event:/SFX/UI/Generic/rightTab/sfx_ui_window_rightTab_Decisions"
							parentanchor = right|top
							size = { 30 30 }
							position = { -6 6 }
							alpha = 0.8

							onclick = "[GetScriptedGui( 'republican_support_candidate' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'candidate', Character.MakeScope ).End )]"
							background = {
								texture = "gfx/interface/buttons/button_lifestyles_base.dds"
							}
							icon = {
								size = { 80% 80% }
								texture = "gfx/interface/icons/character_interactions/support_candidate.dds"
								parentanchor = center
							}
							state = {
								name = _mouse_hierarchy_enter
								duration = 0.1
								alpha = 1
							}
							state = {
								name = _mouse_hierarchy_leave
								duration = 0.1
								alpha = 0.8
							}
						}
						text_single = {
							parentanchor = left|top
							position = { 8 5 }
							raw_text = "@ballotbox_icon![Scope.ScriptValue('republican_election_weight')|1]"
							default_format = "#color:{1,1,1,1};glow_color:{0,0,0,1}"
							tooltip = "[Scope.GetScriptValueDesc('republican_election_weight')]"
						}
					}
					widget = {
						size = { 115 40 }

						background = {
							texture = "gfx/interface/component_tiles/tile_header_background_01.dds"
							margin_top = 4
							margin_left = -4
							margin_right = -4
							margin_bottom = -6
							alpha = 1
							modify_texture = {
								texture = "gfx/interface/buttons/button_stone_glass_mask.dds"
								blend_mode = alphamultiply
								spritetype = corneredTiled
								spriteborder = { 40 40 }
								texture_density = 5
							}

							modify_texture = {
								texture = "gfx/interface/buttons/button_stone_glass_overlay.dds"
								blend_mode = overlay
								alpha = 0.6
							}
						}
						coat_of_arms_icon = {
							parentanchor = center
							position = { 0 -4 }
							size = { 105 105 }
							coat_of_arms = "[Scope.Char.GetHouse.GetHouseCoA.GetTexture('(int32)124','(int32)124')]"
							coat_of_arms_slot = "[Scope.Char.GetHouse.GetHouseCoA.GetSlot('(int32)124','(int32)124')]"
							coat_of_arms_mask = "gfx/interface/window_republic/coa_mask.dds"

							modify_texture = {
								texture = "gfx/interface/buttons/button_stone_glass_overlay.dds"
								blend_mode = overlay
								alpha = 0.6
							}
							modify_texture = {
								texture = "gfx/interface/component_masks/patterns/mask_pattern_02.dds"
								texture_density = 2
								spritetype = corneredtiled
								blend_mode = alphamultiply
								alpha = 0.3
							}
							alpha = 0.65
						}
						icon = {
							size = { 107 100% }
							position = { 0 -4 }
							parentanchor = hcenter|top
							spriteborder = { 30 30 }
							spriteType = corneredStretched
							texture = "gfx/interface/buttons/button_stone_glass_frame.dds"
							texture_density = 4
						}
						text_single = {
							parentanchor = hcenter|top
							text = "[Scope.Char.GetFirstNameNoTooltip]"
							default_format = "#color:{1,1,1,1};glow_color:{0,0,0,1}"
						}
					}
				}
			}
		}
	}

