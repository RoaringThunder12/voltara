window = { name = "vip_actions_window" parentanchor = center layer = top size = { 700 800 } movable = yes
 visible = "[And( GetPlayer.IsValid, GetPlayer.MakeScope.Var('vip_actions_open').IsSet )]"
 using = Window_Background using = Window_Decoration
 vbox = { using = Window_Margins spacing = 10
 header_pattern = { layoutpolicy_horizontal = expanding
 blockoverride "header_text" { text = "vip_actions_title" }
 blockoverride "button_close" { onclick = "[GetScriptedGui('vip_actions_toggle').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" } }
 text_multi = { text = "vip_actions_hint" max_width = 640 autoresize = yes }
 button_standard = { size = { 620 38 } text = "vip_private_report"
 visible = "[GetScriptedGui('vip_private_report').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
 enabled = "[GetScriptedGui('vip_private_report').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
 onclick = "[GetScriptedGui('vip_private_report').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" }
 button_standard = { size = { 620 38 } text = "vip_enact_abolition"
 tooltip = "vip_enact_abolition_tt"
 visible = "[GetScriptedGui('vip_enact_abolition').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
 enabled = "[GetScriptedGui('vip_enact_abolition').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
 onclick = "[GetScriptedGui('vip_enact_abolition').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" }
