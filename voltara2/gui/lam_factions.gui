window = {
	name = "lam_factions_window"
	parentanchor = center
	layer = windows_layer
	size = {
		1830
		980
	}
	movable = yes
	visible = "[And( GetPlayer.IsValid, GetPlayer.MakeScope.Var('lam_factions_open').IsSet )]"
	using = Window_Background
	using = Window_Decoration
	vbox = {
		using = Window_Margins
		background = {
			using = Background_Area_Dark
		}
		header_pattern = {
			layoutpolicy_horizontal = expanding
			blockoverride
			"header_text"
			  {
				text = "vip_title"
			}
			blockoverride
			"button_close"
			  {
				onclick = "[GetScriptedGui('lam_sgui_factions_close').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				onclick = "[CloseGameView( 'factions_window' )]"
				onclick = "[GetVariableSystem.Clear( 'lam_fac_vanilla' )]"
				onclick = "[GetVariableSystem.Clear( 'lam_fac_tab' )]"
			}
		}
		hbox = {
			layoutpolicy_horizontal = expanding
			margin = {
				10
				4
			}
			spacing = 8
 button_standard = { size = { 150 30 } text = "vip_actions_title"
 onclick = "[GetScriptedGui('vip_actions_toggle').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]" }

			button_standard = {
				size = {
					135
					30
				}
				text = "lam_pb_fronts_title"
				onclick = "[GetScriptedGui('lam_pb_gui_open').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
			}
			button_standard = {
				size = {
					150
					30
				}
				text = "lam_pb_other_uprisings"
				tooltip = "lam_pb_other_uprisings_tt"
				onclick = "[GetVariableSystem.Set( 'lam_fac_vanilla', '1' )]"
				onclick = "[GetScriptedGui('lam_sgui_factions_close').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				onclick = "[OpenGameView( 'factions_window' )]"
			}
			button_standard = {
				size = {
					120
					30
				}
				text = "lam_fac_btn_lineage"
				tooltip = "lam_fac_btn_lineage_tt"
				visible = "[Not( GetVariableSystem.HasValue( 'lam_fac_tab', 'harem' ) )]"
				down = "[GetPlayer.MakeScope.Var('lam_fac_lineage_open').IsSet]"
				onclick = "[GetScriptedGui('lam_sgui_fac_lineage_toggle').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
			}
			expand = {}
			hbox = {
				spacing = 8
				datacontext = "[GetPlayer.MakeScope.Var('lam_fac_view').Char]"
				visible = "[Not( GetVariableSystem.HasValue( 'lam_fac_tab', 'harem' ) )]"
				text_single = {
					text = "lam_fac_crown_line"
					fontsize = 17
					fontsize_min = 14
					max_width = 380
					align = left|nobaseline
					tooltip = "lam_fac_crown_tt"
				}
				progressbar_standard = {
					size = {
						140
						10
					}
					min = 0
					max = 100
					value = "[Character.MakeScope.Var('lam_crown').GetValue]"
					tooltip = "lam_fac_crown_tt"
				}
				text_single = {
					text = "lam_fac_ban_line"
					fontsize = 16
					fontsize_min = 13
					max_width = 200
					align = left|nobaseline
					tooltip = "lam_fac_ban_line_tt"
					visible = "[Character.MakeScope.Var('lam_fac_ban').IsSet]"
				}
				text_single = {
					text = "lam_fac_awe_line"
					fontsize = 16
					fontsize_min = 13
					max_width = 220
					align = left|nobaseline
					tooltip = "lam_fac_awe_line_tt"
					visible = "[Character.MakeScope.Var('lam_fac_awe').IsSet]"
				}
			}
			button_standard = {
				size = {
					140
					30
				}
				text = "lam_fac_view_self"
				visible = "[Not( GetVariableSystem.HasValue( 'lam_fac_tab', 'harem' ) )]"
				onclick = "[GetScriptedGui('lam_sgui_factions_view_self').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
			}
			button_standard = {
				size = {
					160
					30
				}
				text = "lam_fac_view_up"
				tooltip = "lam_fac_view_up_tt"
				visible = "[And( Not( GetVariableSystem.HasValue( 'lam_fac_tab', 'harem' ) ), GetScriptedGui('lam_sgui_factions_view_up').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
				enabled = "[GetScriptedGui('lam_sgui_factions_view_up').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				onclick = "[GetScriptedGui('lam_sgui_factions_view_up').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
			}
		}
		text_single = {
			text = "lam_fac_hint"
			fontsize = 15
			fontsize_min = 12
			max_width = 1780
			layoutpolicy_horizontal = expanding
			align = left|nobaseline
			default_format = "#weak"
			margin = {
				12
				0
			}
		}
		hbox = {
			layoutpolicy_horizontal = expanding
			margin = {
				10
				2
			}
			spacing = 8
			datacontext = "[GetPlayer.MakeScope.Var('lam_fac_view').Char]"
			visible = "[And( Not( GetVariableSystem.HasValue( 'lam_fac_tab', 'harem' ) ), Character.MakeScope.Var('lam_is_any').IsSet )]"
			hbox = {
				spacing = 8
				ignoreinvisible = yes
				widget = {
					size = {
						590
						134
					}
					visible = "[Character.MakeScope.Var('lam_is_heir_open').IsSet]"
					background = {
						using = Background_Area
					}
					vbox = {
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding
						margin = {
							8
							4
						}
						spacing = 3
						hbox = {
							layoutpolicy_horizontal = expanding
							spacing = 6
