								size = {
									24
									24
								}
								texture = "gfx/interface/icons/flat_icons/succession.dds"
							}
							text_single = {
								text = "lam_is_heir_title"
								fontsize = 18
								fontsize_min = 15
								max_width = 260
								align = left|nobaseline
							}
							expand = {}
							text_single = {
								text = "lam_is_heir_lead"
								fontsize = 15
								fontsize_min = 12
								max_width = 220
