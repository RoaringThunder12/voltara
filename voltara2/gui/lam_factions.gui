									64
								}
								visible = "[Character.MakeScope.Var('lam_is_heir_xp').IsSet]"
								widget = {
									size = {
										64
										64
									}
									datacontext = "[GetPlayer.MakeScope.Var('lam_fac_view').Char.MakeScope.Var('lam_is_heir_xp').Char]"
									portrait_button = {
										size = {
											58
											64
										}
										using = portrait_base
										portrait_texture = "[Character.GetPortrait('environment_head', 'camera_head', 'idle', PdxGetWidgetScreenSize(PdxGuiWidget.Self))]"
										mask = "gfx/portraits/portrait_mask_head_small.dds"
										effectname = "NoHighlight"
										onclick = "[DefaultOnCharacterClick(Character.GetID)]"
										tooltip = "[Character.GetName]"
										onrightclick = "[DefaultOnCharacterRightClick(Character.GetID)]"
									}
								}
							}
							vbox = {
