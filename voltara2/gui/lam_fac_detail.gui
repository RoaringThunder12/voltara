window = {
	name = "lam_fac_detail_window"
	parentanchor = center
	layer = middle
	size = {
		1240
		880
	}
	movable = yes
	visible = "[And( GetPlayer.IsValid, And( GetPlayer.MakeScope.Var('lam_fac_detail').IsSet, GetPlayer.MakeScope.Var('lam_fac_detail').Char.IsAlive ) )]"
	datacontext = "[GetPlayer.MakeScope.Var('lam_fac_detail').Char]"
	using = Window_Background
	using = Window_Decoration
	vbox = {
		using = Window_Margins
		background = {
			using = Background_Area_Dark
		}
		header_pattern = {
			layoutpolicy_horizontal = expanding
			blockoverride
			"header_text"
			  {
				text = "lam_fac_detail_title"
			}
			blockoverride
			"button_close"
			  {
				onclick = "[GetScriptedGui('lam_sgui_fac_detail_close').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
			}
		}
		hbox = {
			layoutpolicy_horizontal = expanding
			margin = {
				14
				6
			}
			spacing = 16
